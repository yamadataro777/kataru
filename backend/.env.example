PORT=3001
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_KEY=your-supabase-service-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Round prompt quality flags (default: true, set to "false" to disable)
ROUND_PROMPT_V2=true
ROUND_USE_PREVIOUS_RATINGS=true

# Phase 10: Domain Adapter (off | dev | manual_live | live)
# backend と frontend で同じ値に揃えること
PHASE10_ADAPTER=off
